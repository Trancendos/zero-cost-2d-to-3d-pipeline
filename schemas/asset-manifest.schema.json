{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trancendos.local/schemas/asset-manifest.schema.json",
  "title": "AAF Asset Manifest",
  "type": "object",
  "required": ["schema", "asset_id", "created_utc", "source", "outputs", "licensing"],
  "properties": {
    "schema": {"const": "aaf.asset-manifest.v1"},
    "asset_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["sha256", "filename"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "filename": {"type": "string"},
        "consent_record_id": {"type": ["string", "null"]}
      }
    },
    "rig": {
      "type": "object",
      "properties": {
        "tool": {"type": "string"},
        "checkpoint_licence_status": {"enum": ["pending_verification", "approved", "rejected"]},
        "bones_detected": {"type": "integer", "minimum": 0},
        "sidecar": {"type": "string"}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "format"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "format": {"enum": ["glb", "vrm", "fbx", "obj"]}
        }
      }
    },
    "licensing": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending_verification", "approved", "rejected"],
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "l1_structural": {"type": "string"},
        "bones_ok": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
